From 28b41780f9584257c3ac121ed00a561f2a5a1a46 Mon Sep 17 00:00:00 2001
From: Erfan Abdi <erfangplus@gmail.com>
Date: Thu, 26 Aug 2021 13:52:27 +0800
Subject: [PATCH 1/2] lineage: Add more build types

Change-Id: I6cf73bdd7bcf7fde9687d3fd96fde8dcfd01841a
---
 config/version.mk | 12 +++++++++++-
 1 file changed, 11 insertions(+), 1 deletion(-)

diff --git a/config/version.mk b/config/version.mk
index 9fb74174..9965ac70 100644
--- a/config/version.mk
+++ b/config/version.mk
@@ -18,11 +18,21 @@ ifndef LINEAGE_BUILDTYPE
 endif
 
 # Filter out random types, so it'll reset to UNOFFICIAL
-ifeq ($(filter RELEASE NIGHTLY SNAPSHOT EXPERIMENTAL,$(LINEAGE_BUILDTYPE)),)
+ifeq ($(filter RELEASE NIGHTLY SNAPSHOT EXPERIMENTAL VANILLA FOSS GAPPS,$(LINEAGE_BUILDTYPE)),)
     LINEAGE_BUILDTYPE := UNOFFICIAL
     LINEAGE_EXTRAVERSION :=
 endif
 
+ifeq ($(LINEAGE_BUILDTYPE), GAPPS)
+    WITH_GMS := true
+    WITH_GMS_MINIMAL := true
+    GMS_MAKEFILE := gms_minimal.mk
+endif
+
+ifeq ($(LINEAGE_BUILDTYPE), FOSS)
+    $(call inherit-product-if-exists, vendor/foss/foss.mk)
+endif
+
 ifeq ($(LINEAGE_BUILDTYPE), UNOFFICIAL)
     ifneq ($(TARGET_UNOFFICIAL_BUILD_ID),)
         LINEAGE_EXTRAVERSION := -$(TARGET_UNOFFICIAL_BUILD_ID)
-- 
