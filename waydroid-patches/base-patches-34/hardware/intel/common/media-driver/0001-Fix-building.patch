 Android.bp                                               | 9 ++++++++-
 .../linux/common/os/i915/include/mos_bufmgr_api.h        | 1 +
 2 files changed, 9 insertions(+), 1 deletion(-)

diff --git a/Android.bp b/Android.bp
index a7d758c7a..1418e5e89 100644
--- a/Android.bp
+++ b/Android.bp
@@ -38,7 +38,14 @@ common_cflags = [
     "-fno-use-cxa-atexit",
     "-fexceptions",
     "-fcheck-new",
-    "-Werror",
+    "-Wno-unused-function",
+    "-Wno-unused-label",
+    "-Wno-unused-lambda-capture",
+    "-Wno-unused-parameter",
+    "-Wno-unused-private-field",
+    "-Wno-unused-variable",
+    "-Wno-unused-value",
+    "-Wno-missing-field-initializers",
     "-Wno-pragma-pack-suspicious-include",
     "-Wno-unknown-pragmas",
     "-Wno-comments",
diff --git a/media_softlet/linux/common/os/i915/include/mos_bufmgr_api.h b/media_softlet/linux/common/os/i915/include/mos_bufmgr_api.h
index 4e67df8eb..7dcab8280 100644
