From b808feba7e5f297560c7a9b7234a9612aaf864cb Mon Sep 17 00:00:00 2001
From: Ziyang Zhou <ziyang.zhou@outlook.com>
Date: Sat, 17 Jan 2026 14:13:30 +0000
Subject: [PATCH] fix booting

Change-Id: I5656f6dfd489d898654d298a59d6fe4827fdda5f
---
 netbpfload/NetBpfLoad.cpp                                 | 8 +++++---
 .../com_android_server_connectivity_ClatCoordinator.cpp   | 1 +
 2 files changed, 6 insertions(+), 3 deletions(-)

diff --git a/netbpfload/NetBpfLoad.cpp b/netbpfload/NetBpfLoad.cpp
index 8af4dd49a7..0f3f134fac 100644
--- a/netbpfload/NetBpfLoad.cpp
+++ b/netbpfload/NetBpfLoad.cpp
@@ -343,7 +343,7 @@ int main(int argc, char** argv, char * const envp[]) {
         // (this writeFile is known to fail on at least 4.19, but always defaults to 0 on
         // pre-5.13, on 5.13+ it depends on CONFIG_BPF_UNPRIV_DEFAULT_OFF)
         if (writeProcSysFile("/proc/sys/kernel/unprivileged_bpf_disabled", "0\n") &&
-            android::bpf::isAtLeastKernelVersion(5, 13, 0)) return 1;
+            android::bpf::isAtLeastKernelVersion(5, 13, 0)) ALOGE("write 1 to /proc/sys/kernel/unprivileged_bpf_disabled FAILED");
 
         // Enable the eBPF JIT -- but do note that on 64-bit kernels it is likely
         // already force enabled by the kernel config option BPF_JIT_ALWAYS_ON.
@@ -352,13 +352,13 @@ int main(int argc, char** argv, char * const envp[]) {
         // BPF_JIT is required by R VINTF (which means 4.14/4.19/5.4 kernels),
         // but 4.14/4.19 were released with P & Q, and only 5.4 is new in R+.
         if (writeProcSysFile("/proc/sys/net/core/bpf_jit_enable", "1\n") &&
-            android::bpf::isAtLeastKernelVersion(4, 14, 0)) return 1;
+            android::bpf::isAtLeastKernelVersion(4, 14, 0)) ALOGE("write 1 to /proc/sys/net/core/bpf_jit_enable FAILED");
 
         // Enable JIT kallsyms export for privileged users only
         // (Note: this (open) will fail with ENOENT 'No such file or directory' if
         //  kernel does not have CONFIG_HAVE_EBPF_JIT=y)
         if (writeProcSysFile("/proc/sys/net/core/bpf_jit_kallsyms", "1\n") &&
-            android::bpf::isAtLeastKernelVersion(4, 14, 0)) return 1;
+            android::bpf::isAtLeastKernelVersion(4, 14, 0)) ALOGE("write 1 to /proc/sys/net/core/bpf_jit_kallsyms FAILED");
     }
 
     // Create all the pin subdirectories
@@ -383,9 +383,11 @@ int main(int argc, char** argv, char * const envp[]) {
             ALOGE("If this triggers reliably, you're probably missing kernel options or patches.");
             ALOGE("If this triggers randomly, you might be hitting some memory allocation "
                   "problems or startup script race.");
+#if 0
             ALOGE("--- DO NOT EXPECT SYSTEM TO BOOT SUCCESSFULLY ---");
             sleep(20);
             return 2;
+#endif
         }
     }
 
diff --git a/service/jni/com_android_server_connectivity_ClatCoordinator.cpp b/service/jni/com_android_server_connectivity_ClatCoordinator.cpp
index c125bd6479..06218938df 100644
--- a/service/jni/com_android_server_connectivity_ClatCoordinator.cpp
+++ b/service/jni/com_android_server_connectivity_ClatCoordinator.cpp
@@ -130,6 +130,7 @@ static void verifyClatPerms() {
 
 #undef V2
 
+    fatal = false; // HACKED
     if (fatal) abort();
 }
 
